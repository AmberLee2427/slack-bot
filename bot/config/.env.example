# Nancy Bot Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp

# Logging
LOG_LEVEL=INFO

# Knowledge Base
KNOWLEDGE_BASE_PATH=knowledge_base/embeddings
# MCP (Nancy HTTP) — set this to point at a running nancy-brain HTTP server to enable RAG
MCP_BASE_URL=http://localhost:8000
MCP_API_KEY=
MCP_INTEGRATION_TEST=true

# Behaviour
# If RAG is unavailable, Nancy will run in degraded mode and include RAG status in responses.
INCLUDE_RAG_STATUS_IN_CONTEXT=True
