# MCP Server Authentication
MCP_API_KEY=your-secret-api-key-here         # Generate a random key (e.g., openssl rand -hex 32)
MCP_INVITE_CODES=changeme,changeme2          # Comma-separated; keep real codes in .env only
NB_SECRET_KEY=your-jwt-secret-key-here       # For nancy-brain HTTP API JWT tokens

# Slack Credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token          # From Slack app settings
SLACK_SIGNING_SECRET=your-signing-secret     # From Slack app settings
SLACK_ALLOW_UNSIGNED_REQUESTS=false          # Local tests/CI only; Docker hard-codes false
PRIVATE_ALERT_CHANNEL_ID=C0123456789         # Fixed private channel; invite Nancy first
PRIVATE_ALERT_TOKEN=replace-with-random-bearer-token
PRIVATE_ALERT_DRY_RUN=false                  # Validate and preview without calling Slack
NANCY_BOT_PORT=3000                          # Use 3001 locally if port 3000 is occupied

# LLM
LLM_PROVIDER=custom                          # this deployment uses only the custom provider
CUSTOM_API_KEY=your-malpas-api-key           # Obtain from the endpoint administrator
CUSTOM_MODEL=your-model-id                   # Discover with authenticated GET /v1/models
CUSTOM_URL=https://api.malpas.nz/v1          # OpenAI-compatible base URL
ANTHROPIC_API_KEY=                            # Optional; unused when LLM_PROVIDER=custom
CLAUDE_MODEL=claude-sonnet-5                 # Used only when LLM_PROVIDER=anthropic

# Internal Service URLs (do not change for Docker)
MCP_BASE_URL=https://mcp.rges-pit.com        # Existing hosted Nancy Brain
MCP_TIMEOUT_SECONDS=90                       # Allows cold searches to load the embedding models
# MCP (Nancy HTTP) — set this to point at a running nancy-brain HTTP server to enable RAG
# e.g. http://localhost:8000
#MCP_INTEGRATION_TEST=true

# Logging
LOG_LEVEL=INFO

# Knowledge Base
KNOWLEDGE_BASE_PATH=ref/nancy-brain/knowledge_base/embeddings
# MCP (Nancy HTTP) — set this to point at a running nancy-brain HTTP server to enable RAG

# Behaviour
# If RAG is unavailable, Nancy will run in degraded mode and include RAG status in responses.
INCLUDE_RAG_STATUS_IN_CONTEXT=True

DEBUG_LLM=False

# Rate limiting
DAILY_RATE_LIMIT=100
SLACK_ALERT_USER_ID=your-slack-user-id          # DM this user on primary-provider failover
